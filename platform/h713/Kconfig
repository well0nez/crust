if PLATFORM_H713

config H713_HDMI
	bool "HDMI front end contract of the vendor ARISC firmware"
	default y
	help
		Speak the message-box protocol of Allwinner's TV303 ARISC
		firmware on msgbox port 0 (EDID store, hot-plug pin, DDC
		RAM) and port 3 (startup handshake, cpu op req, restore
		finished), so that the Linux driver sun50i-h713-arisc
		keeps working unchanged.

config H713_IR_WAKE_NECX
	bool "Wake from standby on the projector remote (extended NEC)"
	depends on CIR
	default y
	help
		Compare received NEC codes against the vendor's cir_param
		list of the HY310/HY300 Pro (19 address/command pairs).

config H713_POWER_KEY_PIN
	int "Port L pin of the power key (level, active low)"
	default 4
	range 0 31
	help
		standby_param power_key = "PL4" on every board seen.

config H713_RAILS_PIN
	int "Port L pin the vendor standby_param names for all rails, -1 = never drive it"
	default -1
	range -1 31
	help
		standby_param on the HY310 and HY300 Pro puts vdd-cpu,
		vdd-sys, vcc-pll and vcc-dram all on PL6. What hangs on it
		is unmeasured (FB-STANDBY 7.5), so the default never
		touches the pin.

config H713_DRAM_SELF_REFRESH
	bool "Put the DRAM into self-refresh in standby (vendor V1.15 port)"
	help
		The vendor ARISC firmware's DRAM standby driver (blob
		0x142dc enter, 0x145b0 exit), ported register by register
		and checked against the blob in an offline model only. Off,
		standby leaves the DRAM clocked ("light standby"). The DRAM
		parameters below must be the ones the boot loader trained
		the DRAM with.

config H713_DEEP_SLEEP
	bool "Deep sleep: root clocks to OSC24M, PLLs and the PLL LDO off"
	depends on H713_DRAM_SELF_REFRESH
	help
		The rest of the vendor's standby (blob 0xdd20/0xdea8 down,
		0xe3a8/0xddec/0xe3f4 and the MBUS rebuild up): bus and root
		clocks to OSC24M, every PLL off, the RTC's 32k crystal off,
		the PLL LDO off, VDD_SYS reset and gating. Ported, offline
		model only.

config H713_DEEP_PLL_LDO
	bool "Deep sleep: the PLL LDO off"
	depends on H713_DEEP_SLEEP
	default y
	help
		Blob 0xddbc down, 0xddec up. The HY310 has R_PRCM 0x244
		bit 2 (CRYSTAL_EN) set (read 07.10.2026): the 24 MHz clock
		may come through the PLL domain's pads, and upstream crust
		turns that path off before the LDO (PRUEFUNG4). Off for the
		first device run D1a.

config H713_DEEP_VDD_SYS
	bool "Deep sleep: VDD_SYS reset and AVCC/bit 8 gating"
	depends on H713_DEEP_SLEEP
	default y
	help
		Blob 0xdea8 down, 0xe3a8 up. It resets the main domain - CCU
		gates, pin functions, UART0, the msgbox and the SoC watchdog
		that the test runs use as their net - and mainline Linux
		restores none of it (PRUEFUNG4 PD-1, PD-3). Off for D1a.

if H713_DRAM_SELF_REFRESH

config H713_DRAM_CLK
	int "DRAM clock in MHz (U-Boot CONFIG_DRAM_CLK)"
	default 792

config H713_DRAM_TYPE
	int "DRAM type (3 DDR3, 6 LPDDR2, 7 LPDDR3)"
	default 3

config H713_DRAM_ZQ
	hex "dram_para.zq"
	default 0x007b7bfb

config H713_DRAM_ODT_EN
	hex "dram_para.odt_en"
	default 0x1

config H713_DRAM_PARA1
	hex "dram_para.para1"
	default 0x000010f4

config H713_DRAM_PARA2
	hex "dram_para.para2"
	default 0x04000000

config H713_DRAM_MR0
	hex "dram_para.mr0"
	default 0x1c70

config H713_DRAM_MR1
	hex "dram_para.mr1"
	default 0x40

config H713_DRAM_MR2
	hex "dram_para.mr2"
	default 0x18

config H713_DRAM_MR3
	hex "dram_para.mr3"
	default 0x0

config H713_DRAM_TPR5
	hex "dram_para.tpr5"
	default 0x48484848

config H713_DRAM_TPR6
	hex "dram_para.tpr6"
	default 0x48

config H713_DRAM_TPR9
	hex "dram_para.tpr9"
	default 0x0

config H713_DRAM_TPR13
	hex "dram_para.tpr13"
	default 0xb4016103

endif

endif
